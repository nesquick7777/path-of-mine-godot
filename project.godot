[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="PlayerHurtBox"
2d_physics/layer_4="EnemyHurtbox"
2d_physics/layer_5="ObeliskHurtbox"
2d_physics/layer_6="Checker"
2d_physics/layer_7="Fence"
2d_physics/layer_8="FenceChecker"
2d_physics/layer_9="EnemyHitbox"
2d_physics/layer_10="BulletLayer"
2d_physics/layer_11="ObeliskLocation"
2d_physics/layer_12="RockHitBox"
2d_physics/layer_13="ZIndex"
2d_physics/layer_14="Enemy"
2d_physics/layer_18="Coin"
2d_physics/layer_19="TraderSpot"
2d_physics/layer_20="Trader"

[physics]

common/enable_pause_aware_picking=true

[rendering]

2d/snapping/use_gpu_pixel_snap=true
